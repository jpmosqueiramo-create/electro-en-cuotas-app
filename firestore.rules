rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // REGLAS DE SEGURIDAD - ENVÍOS LOW COST
    // ==========================================

    // Borrador administrativo: Lectura y Escritura únicamente para Administradores
    match /shipping_settings/draft_config {
      allow read, write: if request.auth != null;
    }

    // Configuración Publicada: Lectura Pública, Escritura exclusivamente para Administradores
    match /shipping_settings/published_config {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas por defecto para el resto de colecciones de la aplicación
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
